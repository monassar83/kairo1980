{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kairo1980",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },

  // The site is still served as static assets. `main` exists only so that
  // /api/* can be answered — worker/index.js hands every other path straight
  // back to ASSETS, unchanged.
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",

    // A matching static asset is normally served without the Worker running
    // at all, which is exactly what should happen for the menu, the styles
    // and the fonts. Two paths are exceptions, for two different reasons.
    //
    // "/" is the only page allowed to load the checkout SDK, and that
    // permission has to be set on the response (see CHECKOUT_CSP in
    // worker/index.js).
    //
    // Both are pages that STATE the opening hours, and the hours live in the
    // database now that the restaurant can change them. The Worker writes them
    // into the markup on the way out, so a crawler that does not run
    // JavaScript still reads the hours actually kept (see page-render.js).
    // Without this line, /firmencatering would be served straight from the
    // file and would publish whatever config.js said on the day it shipped.
    "run_worker_first": [
      "/", "/firmencatering",
      // The .html twins, so the Worker can answer 301 instead of the
      // platform's 307. Named one by one: googled7bbc73984e8deda.html is
      // Google's verification file and must never be redirected.
      "/index.html", "/impressum.html", "/datenschutz.html", "/firmencatering.html",
      // Served as-is with a 200. Google asks for this exact URL, and a
      // verification that relies on a redirect being followed can lapse.
      "/googled7bbc73984e8deda.html"
    ]
  },

  // The retention sweep: nulls the payer's identity 180 days after a payment,
  // keeping the financial record for the ten years § 147 AO requires. Nightly
  // at 03:17 UTC — a quiet hour, and deliberately not on the hour, where every
  // cron on the platform starts at once.
  //
  // The Datenschutzerklärung states this period. That makes this line part of
  // a published promise rather than housekeeping: if it is removed, the policy
  // becomes untrue. See docs/data-retention.md and worker/retention.js.
  //
  // The second expression is the reconciliation sweep: it asks PayPal about
  // any payment left approved or pending, and captures the ones a lost webhook
  // would otherwise have stranded. Quarter-hourly because a guest who approved
  // a payment at seven expects their dinner, not an apology at three in the
  // morning. It costs one indexed query per tick and usually matches nothing.
  // `scheduled` in worker/index.js runs it on EVERY tick, the nightly one
  // included, and tells the scrub apart by the expression above.
  "triggers": {
    "crons": ["17 3 * * *", "*/15 * * * *"]
  },

  // Payment provenance. Created once with `npx wrangler d1 create
  // kairo1980-payments`, in WEUR — the money and the restaurant are both in
  // Germany, so the ledger stays in Europe too.
  //
  // The id is not a secret: it names a database that nothing can reach without
  // this account's credentials.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kairo1980-payments",
      "database_id": "771d18e5-b826-42f6-ac07-42e38a9dda8a",
      "migrations_dir": "migrations"
    }
  ],

  // Non-secret switches. The credentials themselves are secrets and are set
  // with `wrangler secret put` — never here, and never in a file that ships.
  "vars": {
    // 'sandbox' or 'live'. This is the switch that decides whether real money
    // can move: the Worker withholds online payment entirely on kairo1980.de
    // unless this says 'live' (see sandboxOnProduction in worker/index.js), so
    // sandbox credentials can never reach a real guest.
    //
    // It must agree with the credentials in Cloudflare's secrets. They are
    // different PayPal accounts, and a mismatch fails as "the checkout does
    // not work" rather than as anything that names the cause.
    "PAYPAL_ENV": "live"
  }
}
