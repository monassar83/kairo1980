# Cloudflare Workers static-asset headers.
#
# The site has no build step and therefore no content-hashed filenames, so
# caching has to be decided per file. The rule of thumb: anything that encodes
# a business fact must revalidate, anything immutable can be cached hard.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # No 'unsafe-inline' anywhere: every script lives in its own file and every
  # style in style.css, so the policy can stay strict. google.com is allowed
  # only as a frame, and only after the visitor clicks "Karte laden" — the map
  # is never loaded without consent. form-action 'self' keeps the basket form
  # from being repointed if a script were ever injected.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://www.google.com; form-action 'self'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'; upgrade-insecure-requests

# The ordering page needs a wider policy than this so the checkout SDK can
# load, but a per-path rule here does NOT override the /* rule above — it
# loses to it. So that one exception is set by the Worker on the way out
# (see CHECKOUT_CSP in worker/index.js). Everything else keeps the policy
# above, including impressum and datenschutz.

# Opening hours, delivery prices and the menu live here. A visitor holding a
# stale copy would be shown wrong prices or wrong hours, so these always
# revalidate — they are a few kB and the 304 is cheap.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/config.js
  Cache-Control: public, max-age=0, must-revalidate
/zones.js
  Cache-Control: public, max-age=0, must-revalidate
/reviews.json
  Cache-Control: public, max-age=0, must-revalidate

# Behaviour and styling: a few minutes of staleness is harmless and saves the
# round trip on the common repeat visit.
/lang.js
  Cache-Control: public, max-age=300, must-revalidate
/order.js
  Cache-Control: public, max-age=300, must-revalidate
/qr.js
  Cache-Control: public, max-age=300, must-revalidate
/pay.js
  Cache-Control: public, max-age=300, must-revalidate
/app.js
  Cache-Control: public, max-age=300, must-revalidate
/style.css
  Cache-Control: public, max-age=300, must-revalidate

# The font files are versioned by name and never change in place.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The manifest that lists them is not immutable: adding a script — Arabic, say —
# changes this file, and a visitor holding last year's copy would never load the
# new faces. It is 6 kB and revalidates.
/fonts/fonts.css
  Cache-Control: public, max-age=300, must-revalidate

/images/*
  Cache-Control: public, max-age=604800

# Must stay fetchable for the IndexNow proof-of-ownership check.
/*.txt
  Cache-Control: public, max-age=3600

# Apple fetches this to prove we control the domain, and it has no extension,
# so nothing infers a type and it was served with none at all. Harmless in all
# likelihood, but a verification that fails here fails opaquely — Apple does
# not say why — so the guesswork is removed rather than reasoned about.
/.well-known/apple-developer-merchantid-domain-association
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate
