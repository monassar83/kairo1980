# Files in this repo that must NOT be published to kairo1980.de.
# `assets.directory` is "." (the repo root), so without this list Cloudflare
# uploads everything — including the .git directory — as public static assets.

.git
.github
.gitignore
.assetsignore
wrangler.jsonc
node_modules

# Build-time only: runs in GitHub Actions, never in the browser.
fetch-reviews.js
request-log.json

# Source data and the generators. The generated zones.js and sitemap.xml ARE
# published; these are the editing surface and stay private.
data
tools

# Internal maintenance notes — no reason to serve them to visitors.
README.md
docs

# Logo masters. Kept in git as the source for images/logo-mark.* and
# images/logo-nav.*, but ~4 MB that no page ever requests.
images/Logo.png
images/logo-hero.png
