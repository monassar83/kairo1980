# Files in this repo that must NOT be published to kairo1980.de.
# `assets.directory` is "." (the repo root), so without this list Cloudflare
# uploads everything — including the .git directory — as public static assets.

.git
.github
.gitignore
.assetsignore
wrangler.jsonc
node_modules

# Wrangler's own state and build output. `assets.directory` is the repo root,
# so without these `wrangler dev` watches the files it is itself writing and
# reloads in a loop until the runtime gives up.
.wrangler
.dev.vars
playwright-report
test-results

# Build-time only: runs in GitHub Actions, never in the browser.
fetch-reviews.js
request-log.json

# The Worker and its schema. `main` compiles worker/ into the Worker itself;
# publishing the sources as static files would serve the payment routing —
# and the shape of the database — to anyone who asked for them.
worker
migrations
tests
playwright.config.js
package.json
package-lock.json
.dev.vars.example

# Source data and the generators. The generated zones.js and sitemap.xml ARE
# published; these are the editing surface and stay private.
data
tools

# Internal maintenance notes — no reason to serve them to visitors.
README.md
CLAUDE.md
docs

# Logo masters. Kept in git as the source for images/logo-mark.* and
# images/logo-nav.*, but ~4 MB that no page ever requests.
images/Logo.png
images/logo-hero.png

# Artwork for the business profiles (Apple, Google, Bing, Instagram). Kept in
# git so the exports are reproducible, but no page ever requests them.
brand
